datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model User {
  id             String         @id @default(uuid())
  anonymousAlias String
  publicKey      String         // ECDH Public Key
  deviceIdentity String         @unique
  coupleId       String?
  couple         Couple?        @relation(fields: [coupleId], references: [id])
  answers        UserAnswer[]
  createdDares   Dare[]         @relation("CreatedDares")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Couple {
  id            String             @id @default(uuid())
  pairCode      String             @unique
  users         User[]
  sharedMatches SharedMatch[]
  challenges    CoupleChallenge[]
  intimacyLogs  IntimacyLog[]
  messages      EphemeralMessage[]
  coupleSalt    String             // Cryptographic Salt for Local Answer Hashing
  createdAt     DateTime           @default(now())
}

model QuestionCatalog {
  id               String            @id @default(uuid())
  title            String
  description      String?
  category         String            // BDSM, Roleplay, Sensual, Toys, ENM, Romantic
  intensityLevel   String            // VANILLA, SPICY, ADVENTUROUS
  roleType         String            @default("SYMMETRIC") // SYMMETRIC, GIVER, RECEIVER
  linkedQuestionId String?
  linkedQuestion   QuestionCatalog?  @relation("QuestionPair", fields: [linkedQuestionId], references: [id])
  reverseLink      QuestionCatalog[] @relation("QuestionPair")
  answers          UserAnswer[]
}

model UserAnswer {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  questionId     String
  question       QuestionCatalog @relation(fields: [questionId], references: [id])
  encryptedValue String          // AES-256 encrypted answer payload
  answerHash     String          // H(QuestionID + Answer + CoupleSalt)
  createdAt      DateTime        @default(now())

  @@unique([userId, questionId])
}

model SharedMatch {
  id          String   @id @default(uuid())
  coupleId    String
  couple      Couple   @relation(fields: [coupleId], references: [id])
  questionId  String
  matchStatus String   // MUTUAL_YES, MUTUAL_MAYBE, TENTATIVE_MIXED, HIDDEN
  isStarred   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([coupleId, questionId])
}

model CoupleChallenge {
  id          String    @id @default(uuid())
  coupleId    String
  couple      Couple    @relation(fields: [coupleId], references: [id])
  matchId     String?
  title       String
  description String
  status      String    @default("PENDING") // PENDING, ACCEPTED, COMPLETED, EXPIRED, DECLINED
  pointsValue Int       @default(10)
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model IntimacyLog {
  id              String   @id @default(uuid())
  coupleId        String
  couple          Couple   @relation(fields: [coupleId], references: [id])
  activityType    String
  durationMinutes Int?
  location        String?
  protectionUsed  Boolean  @default(true)
  moodRating      Int      // 1-5 scale
  loggedAt        DateTime @default(now())
}

model Dare {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("CreatedDares", fields: [creatorId], references: [id])
  text        String
  pointsValue Int      @default(10)
  difficulty  String   // EASY, MEDIUM, HOT
  createdAt   DateTime @default(now())
}

model EphemeralMessage {
  id        String   @id @default(uuid())
  coupleId  String
  couple    Couple   @relation(fields: [coupleId], references: [id])
  senderId  String
  payload   String   // Encrypted E2EE JSON packet
  createdAt DateTime @default(now())
}
